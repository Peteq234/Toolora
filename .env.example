# Public Supabase configuration (safe to expose to the browser).
# Project Settings > API in the Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only variables. NEVER prefix these with VITE_ and never commit them.
# Supabase > Project Settings > API > service_role key (bypasses RLS, keep secret).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional second allowlist for administrators, comma separated.
ADMIN_EMAILS=you@example.com
